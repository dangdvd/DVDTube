{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "types": [],
    "baseUrl": ".",
    "paths": { "@shared/*": ["../windows/src/shared/*"], "preact": ["./node_modules/preact"], "preact/*": ["./node_modules/preact/*"], "qrcode": ["./node_modules/@types/qrcode"] }
  },
  "include": ["app/src/**/*.ts", "app/src/**/*.tsx", "types/*.d.ts"]
}
